{
  "name": "@comecaramelos/dsh-collapse-multiline-paste",
  "description": "DSH plugin: collapse pasted multiline text in the Web composer into an inline 'X chars / Y lines' pill that rides the draft like the @ file reference chip",
  "version": "0.0.1",
  "author": "Robe ComeCaramelos <hello@comecaramelos.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:host": "tsc",
    "build:client": "tsc -p src/client/tsconfig.json && node scripts/build-client.mjs",
    "clean": "rm -rf lib",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
